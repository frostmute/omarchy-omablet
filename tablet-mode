#!/usr/bin/env bash
# Backend for the Omarchy Tablet Mode plugin.
set -euo pipefail

state_dir="${XDG_RUNTIME_DIR:-/tmp}/omarchy-tablet-mode"
lock_file="$state_dir/rotation.lock"
mkdir -p "$state_dir"

monitor_info() {
  hyprctl monitors -j | jq -r '
    ([.[] | select(.name | test("^eDP"))] | .[0])
    // ([.[] | select(.focused)] | .[0])
    // .[0]
    | "\(.name) \(.scale)"'
}

apply_rotation() {
  local transform="$1" output scale
  read -r output scale < <(monitor_info)
  [[ -n ${output:-} && "$output" != "null" ]] || {
    echo "No monitor found" >&2
    exit 1
  }
  hyprctl keyword monitor "$output,preferred,auto,$scale,transform,$transform"
}

orientation() {
  case "$1" in
    normal) echo 0 ;;
    right-up) echo 1 ;;
    bottom-up) echo 2 ;;
    left-up) echo 3 ;;
    *) return 1 ;;
  esac
}

watch() {
  # One watcher per user session, even if the shell reloads this plugin.
  exec 9>"$state_dir/watcher.lock"
  flock -n 9 || exit 0
  while :; do
    monitor-sensor 2>/dev/null | while IFS= read -r line; do
      case "$line" in
        *"Accelerometer orientation changed: "*)
          [[ ! -e "$lock_file" ]] || continue
          value=${line##*: }
          transform=$(orientation "$value") || continue
          apply_rotation "$transform" || true
          ;;
      esac
    done
    sleep 1
  done
}

case "${1:-}" in
  watch) watch ;;
  auto) rm -f "$lock_file" ;;
  lock) : > "$lock_file" ;;
  normal) : > "$lock_file"; apply_rotation 0 ;;
  right) : > "$lock_file"; apply_rotation 1 ;;
  inverted) : > "$lock_file"; apply_rotation 2 ;;
  left) : > "$lock_file"; apply_rotation 3 ;;
  *)
    echo "Usage: ${0##*/} {watch|auto|lock|normal|right|inverted|left}" >&2
    exit 2
    ;;
esac
